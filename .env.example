# Grok voice: server-only secret, never NEXT_PUBLIC_. Disabled by default.
XAI_API_KEY=
MCP_VOICE_ENABLED=false
XAI_VOICE_MODEL=grok-voice-3.0
# Postgres 共有台帳の日次秒数（JST）。DDL は db-apply-sql で適用する。
MCP_VOICE_DAILY_SECONDS=1800
MCP_VOICE_FREE_DAILY_SECONDS=180
MCP_VOICE_MAX_SESSION_SECONDS=180
MCP_VOICE_MAX_TOOL_CALLS=20
# Cloud Run の X-Forwarded-For は末尾が接続元。追加 LB がある場合だけその台数。
TRUSTED_PROXY_HOPS=0
# Only honored in NODE_ENV=development, requires MCP_VOICE_ENABLED=true.
MCP_VOICE_MOCK=false

# 公開MCPの賃貸オンデマンド取得。1 / true のみ有効（既定OFF）。
# nifty サービス特約 第13条5号はスクレイピングを禁止。有効化は運営者の判断。
RENTALS_ON_DEMAND_ENABLED=0
# 一覧ページ数: 既定3、上限5。待機: 既定・下限20秒、上限60秒。
RENTALS_ON_DEMAND_MAX_PAGES=3
RENTALS_ON_DEMAND_DELAY_MS=20000
