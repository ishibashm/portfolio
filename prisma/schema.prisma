generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model BlogPost {
  id          String   @id
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime
  authorId    String
  tags        String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  User        User     @relation(fields: [authorId], references: [id])
}

model PortfolioImage {
  id        String   @id
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  Account       Account[]
  BlogPost      BlogPost[]
  Session       Session[]
  MetaphysicalStateLog MetaphysicalStateLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rental_properties {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_name      String
  area               String?
  rent               Int?
  management_fee     Int?
  layout             String?
  size_sqm           Decimal?  @db.Decimal
  is_new_build       Boolean?
  minutes_to_station Int?
  first_seen_at      DateTime? @default(now()) @db.Timestamptz(6)
  last_seen_at       DateTime? @default(now()) @db.Timestamptz(6)
  source_emails      String[]
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  url                String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_configs {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_email           String    @unique
  birth_date           String?
  birth_lat            Float?
  birth_lon            Float?
  base_lat             Float?
  base_lon             Float?
  base_sync_timestamp  DateTime? @db.Timestamptz(6)
  baseline_hrv_mean    Float?
  baseline_hrv_std     Float?
  baseline_gsr_mean    Float?
  baseline_gsr_std     Float?
  encrypted_gemini_key String?
  updated_at           DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model StockTarget {
  id             String   @id @default(cuid())
  code           String
  companyName    String
  market         String?
  price          Float?
  per            Float?
  pbr            Float?
  roe            Float?
  dividendYield  Float?
  analysisReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RealEstateTarget {
  id             String   @id @default(cuid())
  title          String
  url            String?
  price          Float?
  yield          Float?
  location       String?
  buildingAge    Int?
  propertyType   String?
  analysisReason String?
  source         String   @default("gas_rental_scraper")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimingAstrology {
  id               String   @id @default(cuid())
  date             DateTime
  kuseiType        String
  dailyDirection   String?
  monthlyDirection String?
  insight          String?
  source           String   @default("yakumoin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelemetryLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  geomancyScore     Float?
  astrophysicsScore Float?
  magneticF         Float?
  hazardRisk        Float?
  kpIndex           Float?
  isPersonalVoid    Boolean  @default(false)
  metadata          String?
}

model MetaphysicalStateLog {
  id                  String   @id @default(cuid())
  userId              String?
  targetDate          DateTime

  environmentalBazi   Json?
  personalBazi        Json?
  
  physicalLayers      Json?
  classicalLayers     Json?
  
  ansLoad             Float?
  kpIndex             Float?

  metadata            Json?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  User                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetDate])
  @@index([userId])
}

model MunicipalityWealth {
  id                       String   @id @default(cuid())
  areaCode                 String   @unique
  areaName                 String
  taxableIncomeThousandYen Float
  taxpayersCount           Float
  incomeYen                Float
  incomePerCapita          Float
  dataYear                 String?
  lat                      Float?
  lon                      Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
