generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. CORE / LAUNCHER / AUTH & USER DOMAIN
// ==========================================

model User {
  id                   String                 @id
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  Account              Account[]
  BlogPost             BlogPost[]
  Session              Session[]
  MetaphysicalStateLog MetaphysicalStateLog[]
  KnowledgeDocument    KnowledgeDocument[]
  RelocationHistory    RelocationHistory[]
  RelocationSimulation RelocationSimulation[]
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user_configs {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_email           String    @unique
  // Supabase の user.id。メールアドレスは変更できるため、こちらが安定キー。
  // 既存行のために NULL 許容にしてあり、user_email はフォールバックとして残す。
  user_id              String?   @unique @db.Uuid
  birth_date           String?
  birth_lat            Float?
  birth_lon            Float?
  base_lat             Float?
  base_lon             Float?
  base_sync_timestamp  DateTime? @db.Timestamptz(6)
  baseline_hrv_mean    Float?
  baseline_hrv_std     Float?
  baseline_gsr_mean    Float?
  baseline_gsr_std     Float?
  encrypted_gemini_key String?
  presets              Json?
  updated_at           DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model BlogPost {
  id          String   @id
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime
  authorId    String
  tags        String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  User        User     @relation(fields: [authorId], references: [id])
}

model PortfolioImage {
  id        String   @id
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model KnowledgeDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kb_id      Int      @unique @default(autoincrement()) // Base for generating tickets like KB000123
  status     String   @default("Draft")
  priority   String   @default("Medium")
  type       String   @default("Note")
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  content    String
  tags       String[]
  domain     String?
  category   String?
  embedding  Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  chunks KnowledgeChunk[]

  @@index([user_id])
}

model KnowledgeChunk {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String            @db.Uuid
  document    KnowledgeDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  chunk_index Int
  content     String
  token_count Int?

  // Storing embedding as JSON to maintain compatibility with the root schema's approach
  embedding Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([document_id])
}

model VisualizedComponent {
  id        String   @id @default(cuid())
  title     String
  style     String
  inputData Json
  cleanHtml String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentTheme {
  id             String   @id @default(cuid())
  background     String
  foreground     String
  accent         String
  glowColor      String
  glowIntensity  Float
  animationSpeed String
  fontTheme      String
  noiseOpacity   Float
  borderRadius   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentActivityLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  triggerType    String
  details        String
  thoughtProcess String
  actions        String
  textResponse   String?
  codeChange     Json?
  status         String
  errorMessage   String?
}

// ==========================================
// 2. SUBDOMAIN 1: METAPHYSICAL & TIME DOMAIN
// ==========================================

model TimingAstrology {
  id               String   @id @default(cuid())
  date             DateTime
  kuseiType        String
  dailyDirection   String?
  monthlyDirection String?
  insight          String?
  source           String   @default("yakumoin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelemetryLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  geomancyScore     Float?
  astrophysicsScore Float?
  magneticF         Float?
  hazardRisk        Float?
  kpIndex           Float?
  isPersonalVoid    Boolean  @default(false)
  metadata          String?
}

model MetaphysicalStateLog {
  id         String   @id @default(cuid())
  userId     String?
  targetDate DateTime

  environmentalBazi Json?
  personalBazi      Json?

  physicalLayers  Json?
  classicalLayers Json?

  ansLoad Float?
  kpIndex Float?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetDate])
  @@index([userId])
}

model RelocationHistory {
  id            String   @id @default(cuid())
  userId        String?
  departureDate DateTime
  datePrecision String   @default("DAY") // "YEAR" | "MONTH" | "DAY" | "HOUR"
  fromName      String
  fromLat       Float
  fromLon       Float
  toName        String
  toLat         Float
  toLon         Float
  purpose       String   @default("TRAVEL") // "MIGRATION" | "TRAVEL"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 保存時点の吉凶判定のスナップショット。
  //
  // 判定エンジンは改良で変わり、過去の日付の判定も遡って変わる。
  // 一覧表示は常に現在のエンジンで再評価するが（それが最新の知見）、
  // 「決めたときに何と表示されていたか」はここでしか再現できない。
  // 中身: { direction, bearingDeg, tier, finalStatus, yearLayer,
  //         monthLayer, dayLayer, blockedByTenchusatsu, personalStar,
  //         voidZodiacs, tenchusatsuMode, useClassical, directionFilterMode }
  judgment      Json?
  engineVersion String?

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RelocationSimulation {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  steps     Json // Array of step objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ==========================================
// 3. SUBDOMAIN 2: REAL ESTATE & SPATIAL DOMAIN
// ==========================================

model rental_properties {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_name      String
  area               String?
  rent               Int?
  management_fee     Int?
  layout             String?
  size_sqm           Decimal?  @db.Decimal
  is_new_build       Boolean?
  minutes_to_station Int?
  first_seen_at      DateTime? @default(now()) @db.Timestamptz(6)
  last_seen_at       DateTime? @default(now()) @db.Timestamptz(6)
  source_emails      String[]
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  url                String?   @unique
  address            String?
  lat                Float?
  lon                Float?
  building_age       Int?
  floor              String?
  source_scraper     String?   @default("email")
  // Nifty が返す掲載期限。掲載が終わった物件のリンクは 404 になるため、
  // ここを過ぎたものはスキャナーから外し、purge で削除する。
  expire_date        DateTime? @db.Timestamptz(6)

  // スキャナー（/api/rentals/arbitrage）の絞り込みに使う列。
  //
  // このテーブルだけインデックスが 1 つも無く、シーケンシャルスキャンに
  // なっていた。とくに鮮度表示のための max(last_seen_at) は絞り込み条件を
  // 持たないので、リクエストごとに全行を読む（2026-08-09 の実測で 45 万行・
  // 225MB、Parallel Seq Scan で 130 ms）。
  //
  // prisma db push はスキーマに無いインデックスを削除する。手で作らず
  // 必ずここに書くこと（run-seed.yml が db push を実行する）。
  @@index([last_seen_at])
  @@index([lat, lon])
  // 都道府県での絞り込みは address LIKE '兵庫県%' の前方一致。
  // 既定の照合順序では通常の btree が前方一致に使われないため、
  // 演算子クラスを指定する。
  @@index([address(ops: raw("text_pattern_ops"))])
}

// 町丁目 → 座標の永続キャッシュ。geocode_properties.ts が作成・管理する
// （スクリプト側に CREATE TABLE IF NOT EXISTS があるためマイグレーション不要）。
// プロセス内キャッシュだけだと実行のたびに同じ町を国土地理院へ引き直し、
// 仕事の総量が「行数」に比例してしまう。表に持てば総量は「町丁目の数」
// （全国でも約19万）で頭打ちになる。ここに載せるのは db push が
// この表を「スキーマに無いもの」として落とさないようにするため。
model geocode_towns {
  town       String   @id
  lat        Float?
  lon        Float?
  not_found  Boolean  @default(false)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model RealEstateTarget {
  id             String   @id @default(cuid())
  title          String
  url            String?
  price          Float?
  yield          Float?
  location       String?
  buildingAge    Int?
  propertyType   String?
  analysisReason String?
  source         String   @default("gas_rental_scraper")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScrapeTask {
  id          String   @id @default(cuid())
  url         String   @unique
  status      String   @default("PENDING")
  last_page   Int      @default(1)
  total_pages Int?
  updated_at  DateTime @updatedAt
}

model MunicipalityWealth {
  id                       String   @id @default(cuid())
  areaCode                 String   @unique
  areaName                 String
  taxableIncomeThousandYen Float
  taxpayersCount           Float
  incomeYen                Float
  incomePerCapita          Float
  dataYear                 String?
  lat                      Float?
  lon                      Float?
  landPricePerSqm          Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ==========================================
// 4. SUBDOMAIN 3: QUANT FINANCE & TRENDS DOMAIN
// ==========================================

model XPost {
  id            String   @id
  url           String
  authorHandle  String
  authorDisplay String
  datetime      DateTime
  text          String
  quotedUrls    String[]
  externalLinks String[]
  savedMedia    String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorHandle])
  @@index([datetime])
}

/// お問い合わせフォームの受信箱。
/// 運営者の個人メールアドレスをサイトに書かずに連絡手段を用意するために置く。
/// AdSense の審査では連絡手段の有無が見られる。
model contact_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  body       String
  /// 受信時の User-Agent。いたずら投稿の切り分け用。
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  handled    Boolean  @default(false)
}
