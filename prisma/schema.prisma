generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. CORE / LAUNCHER / AUTH & USER DOMAIN
// ==========================================

model User {
  id                   String                 @id
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  Account              Account[]
  BlogPost             BlogPost[]
  Session              Session[]
  MetaphysicalStateLog MetaphysicalStateLog[]
  KnowledgeDocument    KnowledgeDocument[]
  RelocationHistory    RelocationHistory[]
  RelocationSimulation RelocationSimulation[]
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user_configs {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_email           String    @unique
  // Supabase の user.id。メールアドレスは変更できるため、こちらが安定キー。
  // 既存行のために NULL 許容にしてあり、user_email はフォールバックとして残す。
  user_id              String?   @unique @db.Uuid
  birth_date           String?
  birth_lat            Float?
  birth_lon            Float?
  base_lat             Float?
  base_lon             Float?
  base_sync_timestamp  DateTime? @db.Timestamptz(6)
  baseline_hrv_mean    Float?
  baseline_hrv_std     Float?
  baseline_gsr_mean    Float?
  baseline_gsr_std     Float?
  encrypted_gemini_key String?
  presets              Json?
  /// 行が作られた日時＝はじめて設定を保存した日時。
  /// **既定値を置かない。** 既定値で埋めると、列を足した日に既存の全員が
  /// 「今日登録した」ことになる。列の追加より前からいる人は null のままにし、
  /// 管理ページでは「記録開始前」として数える。
  created_at           DateTime? @db.Timestamptz(6)
  updated_at           DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// 記事。これまで content/blog/*.md に置いていたものを DB へ移す。
///
/// 表そのものは以前からある（使われないまま残っていた）。新しく作らず、
/// 足りない列を足して使う。同じ役目の表を 2 つ持つと、どちらが本物か
/// 分からなくなる。
///
/// 本文は Markdown のまま持つ。書き味と表示（BlogArticleBody）を変えずに
/// 置き場だけ移すため。HTML に直して保存すると、あとで表示を変えたときに
/// 過去の記事だけ古い見た目のまま残る。
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  /// 一覧に出す要約。frontmatter の description に対応する。
  excerpt     String?
  /// 記事の分類。frontmatter の category に対応する。
  category    String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// NextAuth の User。**管理画面から書いた記事には紐づく相手が居ない**
  /// ので任意にする。必須のままだと、記事を 1 本書くために User の行を
  /// 先に作る必要があり、認証の都合が記事の都合に混ざる。
  authorId    String?
  /// カンマ区切り。frontmatter の tags と同じ形にして、移行で崩れないようにする。
  tags        String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  User        User?    @relation(fields: [authorId], references: [id])

  /// 一覧は「公開済みを新しい順」でしか引かない。
  @@index([published, publishedAt])
}

model PortfolioImage {
  id        String   @id
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model KnowledgeDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kb_id      Int      @unique @default(autoincrement()) // Base for generating tickets like KB000123
  status     String   @default("Draft")
  priority   String   @default("Medium")
  type       String   @default("Note")
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  content    String
  tags       String[]
  domain     String?
  category   String?
  embedding  Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  chunks KnowledgeChunk[]

  @@index([user_id])
}

model KnowledgeChunk {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String            @db.Uuid
  document    KnowledgeDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  chunk_index Int
  content     String
  token_count Int?

  // Storing embedding as JSON to maintain compatibility with the root schema's approach
  embedding Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([document_id])
}

model VisualizedComponent {
  id        String   @id @default(cuid())
  title     String
  style     String
  inputData Json
  cleanHtml String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentTheme {
  id             String   @id @default(cuid())
  background     String
  foreground     String
  accent         String
  glowColor      String
  glowIntensity  Float
  animationSpeed String
  fontTheme      String
  noiseOpacity   Float
  borderRadius   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentActivityLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  triggerType    String
  details        String
  thoughtProcess String
  actions        String
  textResponse   String?
  codeChange     Json?
  status         String
  errorMessage   String?
}

// ==========================================
// 2. SUBDOMAIN 1: METAPHYSICAL & TIME DOMAIN
// ==========================================

model TimingAstrology {
  id               String   @id @default(cuid())
  date             DateTime
  kuseiType        String
  dailyDirection   String?
  monthlyDirection String?
  insight          String?
  source           String   @default("yakumoin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelemetryLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  geomancyScore     Float?
  astrophysicsScore Float?
  magneticF         Float?
  hazardRisk        Float?
  kpIndex           Float?
  isPersonalVoid    Boolean  @default(false)
  metadata          String?
}

model MetaphysicalStateLog {
  id         String   @id @default(cuid())
  userId     String?
  targetDate DateTime

  environmentalBazi Json?
  personalBazi      Json?

  physicalLayers  Json?
  classicalLayers Json?

  ansLoad Float?
  kpIndex Float?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetDate])
  @@index([userId])
}

// 家賃市場の日次サマリー。毎晩 build_market_stats.ts が 1 県 1 行を upsert する。
//
// marketStats.json は毎晩上書きされるため、「家賃水準がどう動いてきたか」は
// どこにも残らない。株価でいう終値の記録が無い状態で、後から遡って
// 再構成することもできない（過去の掲載はパージで消えるため）。
// ここに毎晩の中央値を積むことで、初めて時系列（家賃指数）が育つ。
// 行数は 1 日 48 行（47 県 + 全国）で、10 年でも 18 万行に満たない。
model MarketDailySummary {
  date          DateTime @db.Date
  prefecture    String // 県名。全国合算は "全国"
  n             Int // 集計対象の掲載数
  medianRent    Int // 総家賃（管理費込み）の中央値
  medianSqmRent Int // ㎡単価の中央値。面積構成の変化に強い実質的な指数
  p25Rent       Int
  p75Rent       Int
  createdAt     DateTime @default(now())

  @@id([date, prefecture])
}

model RelocationHistory {
  id            String   @id @default(cuid())
  userId        String?
  departureDate DateTime
  datePrecision String   @default("DAY") // "YEAR" | "MONTH" | "DAY" | "HOUR"
  fromName      String
  fromLat       Float
  fromLon       Float
  toName        String
  toLat         Float
  toLon         Float
  purpose       String   @default("TRAVEL") // "MIGRATION" | "TRAVEL"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 保存時点の吉凶判定のスナップショット。
  //
  // 判定エンジンは改良で変わり、過去の日付の判定も遡って変わる。
  // 一覧表示は常に現在のエンジンで再評価するが（それが最新の知見）、
  // 「決めたときに何と表示されていたか」はここでしか再現できない。
  // 中身: { direction, bearingDeg, tier, finalStatus, yearLayer,
  //         monthLayer, dayLayer, blockedByTenchusatsu, personalStar,
  //         voidZodiacs, tenchusatsuMode, useClassical, directionFilterMode }
  judgment      Json?
  engineVersion String?

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RelocationSimulation {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  steps     Json // Array of step objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ==========================================
// 3. SUBDOMAIN 2: REAL ESTATE & SPATIAL DOMAIN
// ==========================================

model rental_properties {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_name      String
  area               String?
  rent               Int?
  management_fee     Int?
  layout             String?
  size_sqm           Decimal?  @db.Decimal
  is_new_build       Boolean?
  minutes_to_station Int?
  first_seen_at      DateTime? @default(now()) @db.Timestamptz(6)
  last_seen_at       DateTime? @default(now()) @db.Timestamptz(6)
  source_emails      String[]
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  url                String?   @unique
  address            String?
  lat                Float?
  lon                Float?
  building_age       Int?
  floor              String?
  source_scraper     String?   @default("email")
  // Nifty が返す掲載期限。掲載が終わった物件のリンクは 404 になるため、
  // ここを過ぎたものはスキャナーから外し、purge で削除する。
  expire_date        DateTime? @db.Timestamptz(6)

  // スキャナー（/api/rentals/arbitrage）の絞り込みに使う列。
  //
  // このテーブルだけインデックスが 1 つも無く、シーケンシャルスキャンに
  // なっていた。とくに鮮度表示のための max(last_seen_at) は絞り込み条件を
  // 持たないので、リクエストごとに全行を読む（2026-08-09 の実測で 45 万行・
  // 225MB、Parallel Seq Scan で 130 ms）。
  //
  // prisma db push はスキーマに無いインデックスを削除する。手で作らず
  // 必ずここに書くこと（run-seed.yml が db push を実行する）。
  /// 名寄せキー（建物名の正規化）と市区町村キー。**書き込み時に
  /// トリガーが埋める**（prisma/sql/20260814_add_rental_dedupe_keys.sql）。
  /// 以前はスキャナーがリクエストのたびに正規表現で作っていて、
  /// 全国走査 22 秒の律速になっていた。トリガーは Prisma の管理外なので
  /// db push に消されないが、**この 2 列と下の索引は消される**。
  /// スキーマから外さないこと。
  name_key         String?
  municipality_key String?

  @@index([last_seen_at])
  @@index([lat, lon])
  // 都道府県での絞り込みは address LIKE '兵庫県%' の前方一致。
  // 既定の照合順序では通常の btree が前方一致に使われないため、
  // 演算子クラスを指定する。
  @@index([address(ops: raw("text_pattern_ops"))])
  // 名寄せ（DISTINCT ON）の並びをそのまま引く。これが無いと
  // 100 万行のソートに戻る。
  @@index([name_key, floor, layout, size_sqm, rent])
}

// 町丁目 → 座標の永続キャッシュ。geocode_properties.ts が作成・管理する
// （スクリプト側に CREATE TABLE IF NOT EXISTS があるためマイグレーション不要）。
// プロセス内キャッシュだけだと実行のたびに同じ町を国土地理院へ引き直し、
// 仕事の総量が「行数」に比例してしまう。表に持てば総量は「町丁目の数」
// （全国でも約19万）で頭打ちになる。ここに載せるのは db push が
// この表を「スキーマに無いもの」として落とさないようにするため。
model geocode_towns {
  town       String   @id
  lat        Float?
  lon        Float?
  not_found  Boolean  @default(false)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// 郵便番号と住所・座標の対応表。
///
/// 場所の入力を楽にするために持つ。元データは日本郵便の郵便番号データで、
/// **あちらに座標は無い**ので、住所から座標は取り込みのときに国土地理院で
/// 引いて一緒に持つ（画面を開くたびに外へ出ないようにするため）。
///
/// 表と索引は prisma/sql/20260815_add_postal_codes.sql が正。db push は
/// スキーマに無い表・索引を消すので、片方だけ直さないこと。
model postal_codes {
  /// 7 桁。ハイフンは持たない。
  code       String   @id @db.Char(7)
  /// 都道府県から町域まで繋げた形。
  address    String
  /// 引けなかった番号は null で残す（行は消さない）。
  lat        Float?
  lon        Float?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model RealEstateTarget {
  id             String   @id @default(cuid())
  title          String
  url            String?
  price          Float?
  yield          Float?
  location       String?
  buildingAge    Int?
  propertyType   String?
  analysisReason String?
  source         String   @default("gas_rental_scraper")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScrapeTask {
  id          String   @id @default(cuid())
  url         String   @unique
  status      String   @default("PENDING")
  last_page   Int      @default(1)
  total_pages Int?
  updated_at  DateTime @updatedAt
}

model MunicipalityWealth {
  id                       String   @id @default(cuid())
  areaCode                 String   @unique
  areaName                 String
  taxableIncomeThousandYen Float
  taxpayersCount           Float
  incomeYen                Float
  incomePerCapita          Float
  dataYear                 String?
  lat                      Float?
  lon                      Float?
  landPricePerSqm          Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ==========================================
// 4. SUBDOMAIN 3: QUANT FINANCE & TRENDS DOMAIN
// ==========================================

model XPost {
  id            String   @id
  url           String
  authorHandle  String
  authorDisplay String
  datetime      DateTime
  text          String
  quotedUrls    String[]
  externalLinks String[]
  savedMedia    String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorHandle])
  @@index([datetime])
}

/// お問い合わせフォームの受信箱。
/// 運営者の個人メールアドレスをサイトに書かずに連絡手段を用意するために置く。
/// AdSense の審査では連絡手段の有無が見られる。
model contact_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  body       String
  /// 受信時の User-Agent。いたずら投稿の切り分け用。
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  handled    Boolean  @default(false)
}

/// 方位・日取りについての利用者の投稿。
///
/// 記事ページは計算結果が中心で、ページ間の差が数値だけになりやすい。
/// 「実際にその方位へ引越してどうだったか」は計算では作れないうえ、
/// 同じ方位でも人によって違うので、ページ固有の中身になる。
/// AdSense の「価値の低いコンテンツ」への対処としても、ここが効く。
///
/// 投稿はログイン必須（Supabase の Google ログイン）。匿名を許すと
/// レート制限と承認の仕組みが要るが、この DB は一度 Supabase Free の
/// 500MB を超えて移設した経緯があり（docs/db-migration/README.md）、
/// 行数が読めない書き込み口を増やしたくない。
///
/// topic_key でページに紐づける。ページ種別ごとに表を分けると、
/// 一覧・投稿・削除を種別の数だけ書くことになる。
///   houi:2026:3      … 本命三碧木星の 2026 年の記事
///   houi:2026:3:9    … 同 9 月
///   calendar:2026-09 … 2026 年 9 月の日取り
///   area:23100       … 市区町村
model DirectionComment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// どのページに属するか。上のコメントの形式。
  topic_key    String
  /// Supabase の user.id。表示には使わない。
  user_id      String   @db.Uuid
  /// 投稿時点の表示名。Supabase 側で改名されても過去の投稿は変えない。
  display_name String
  /// 本文。長さは API 側でも検証する。
  body         String
  /// 荒らしを隠すための状態。既定は公開。
  status       String   @default("published")
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  /// 一覧は topic_key で引いて新しい順に並べる。
  @@index([topic_key, created_at])
  /// 1 人あたりの投稿数の確認（連投の抑制）に使う。
  @@index([user_id, created_at])
  @@map("direction_comments")
}

/// 九星気学の鑑定士の掲載。
///
/// 記事は計算結果を出せるが「うちの事情だとどうか」には答えられない。
/// そこに応えられる人を並べておくと、読み手には次の行き先ができ、
/// 鑑定士には集客の動機ができる。こちらは費用をかけずに、
/// 計算では作れない中身と信頼性が増える。
///
/// 自己申告をそのまま公開しない。名乗るだけで連絡先付きの掲載が作れると、
/// 宣伝と詐称の置き場になる。登録はログイン必須、公開は管理者の承認後。
/// status が approved のものだけを返す。
///
/// 1 人 1 件。user_id を一意にして、同じ人が複数の掲載を持てないようにする。
model Practitioner {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Supabase の user.id。1 人 1 件。
  user_id      String   @unique @db.Uuid
  /// 連絡用。公開しない。
  email        String
  /// 掲載名（屋号・鑑定名）。
  display_name String
  /// 一行の紹介。
  headline     String
  /// 対応地域。都道府県名か「オンライン」。
  area         String
  /// 得意分野。カンマ区切りではなく配列で持つ。
  specialties  String[]
  /// 本文。
  profile      String
  /// 連絡先の URL。http/https のみ。
  website_url  String?
  /// pending: 申請中 / approved: 公開中 / hidden: 非公開に戻した
  status       String   @default("pending")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  /// 一覧は公開中のものを新しい順に引く。
  @@index([status, created_at])
  @@map("practitioners")
}

/// ページ閲覧の記録。誰が来ているかではなく「来ているかどうか」を測る。
///
/// アクセス解析が何も無く、利用者がいるのかどうかすら分からなかったので、
/// 最小の自前計測を置く。外部サービス（GA など）を使わないのは、
/// クッキー同意バナーを出したくないのと、データを外に出さないため。
///
/// 個人を特定できるものは持たない。
///   - visitor_hash は sha256(IP + UA + 日付)。日付が入るので翌日には
///     同じ人を追えない（Plausible と同じ考え方）。IP そのものは保存しない
///   - クッキーも localStorage も使わない
model PageView {
  id            String   @id @default(cuid())
  /// 集計の単位となる日（JST）。"2026-08-13" 形式。
  day           String
  /// 閲覧されたパス。クエリは含めない。
  path          String
  /// その日の中でだけ同一人物を束ねられる匿名ハッシュ。
  visitor_hash  String
  /// 参照元のホスト名だけ（URL 全体は持たない）。直接来訪は null。
  referrer_host String?
  /// "pc" | "mobile" | "tablet"。UA そのものは保存しない。
  /// 列を足す前の行と判定不能な UA は null（「不明」として集計する）。
  device        String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  /// 日別の PV/UV 集計と、ページ別の内訳の両方をこの並びで引く。
  @@index([day, path])
  @@map("page_views")
}

/// お気に入りに入れた物件。
///
/// 物件そのもの（rental_properties）は掲載が終わると消えるか、掲載終了の
/// 印が付く。外部キーで縛ると、消えたときにお気に入りごと消えて「なぜ
/// 減ったのか」が利用者に分からない。property_id は**ただの文字列**として
/// 持ち、表示側で引けなかったものは「掲載終了」として出す。
///
/// 同じ人が同じ物件を二度入れられないよう (user_id, property_id) に一意を
/// 置く。押すたびに行が増えると、外すときにどれを消すかが決まらない。
model FavoriteProperty {
  id          String   @id @default(cuid())
  /// Supabase の user.id。user_configs と同じ安定キーを使う。
  user_id     String   @db.Uuid
  /// rental_properties.id。外部キーにはしない（上のコメント）。
  property_id String
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  /// 一覧は「新しく入れた順」で出す。
  @@unique([user_id, property_id])
  @@index([user_id, created_at])
  @@map("favorite_properties")
}

/// 外部 API の呼び出し 1 回。従量課金の推定に使う。
///
/// 1 回 1 行で持つ。日ごとに畳んだ形にすると、あとから「どの経路が高いか」を
/// 出したくなったときに戻せない。呼び出し自体が多くない（メール取込・
/// スマート検索・時期の相談）ので、行数は問題にならない。
///
/// トークン数を持つのは、LLM の課金が回数ではなくトークンで決まるため。
/// 取れない提供元・経路では null にする。**0 と null は別物**で、
/// 0 は「使わなかった」、null は「数えられなかった」。
model ApiUsage {
  id            String   @id @default(cuid())
  /// 集計の単位となる日（JST）。"2026-08-13" 形式。page_views と揃える。
  day           String
  /// 提供元。"google" / "anthropic" など。課金はここ単位で来る。
  provider      String
  /// モデル名。同じ提供元でも単価が違うので分けて数える。
  model         String
  /// 呼び出した経路。どの機能が費用を出しているかを見るため。
  route         String
  /// 入力トークン。取れないときは null（0 ではない）。
  input_tokens  Int?
  /// 出力トークン。同上。
  output_tokens Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  /// 日別・提供元別の集計をこの並びで引く。
  @@index([day, provider])
  @@map("api_usage")
}
