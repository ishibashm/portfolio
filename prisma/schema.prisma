generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model BlogPost {
  id          String   @id
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime
  authorId    String
  tags        String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  User        User     @relation(fields: [authorId], references: [id])
}

model PortfolioImage {
  id        String   @id
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                 @id
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  Account              Account[]
  BlogPost             BlogPost[]
  Session              Session[]
  MetaphysicalStateLog MetaphysicalStateLog[]
  KnowledgeDocument    KnowledgeDocument[]
  RelocationHistory    RelocationHistory[]
  RelocationSimulation RelocationSimulation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ScrapeTask {
  id          String   @id @default(cuid())
  url         String   @unique
  status      String   @default("PENDING")
  last_page   Int      @default(1)
  total_pages Int?
  updated_at  DateTime @updatedAt
}

model rental_properties {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_name      String
  area               String?
  rent               Int?
  management_fee     Int?
  layout             String?
  size_sqm           Decimal?  @db.Decimal
  is_new_build       Boolean?
  minutes_to_station Int?
  first_seen_at      DateTime? @default(now()) @db.Timestamptz(6)
  last_seen_at       DateTime? @default(now()) @db.Timestamptz(6)
  source_emails      String[]
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  url                String?   @unique
  address            String?
  lat                Float?
  lon                Float?
  building_age       Int?
  floor              String?
  source_scraper     String?   @default("email")
}

model user_configs {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_email           String    @unique
  birth_date           String?
  birth_lat            Float?
  birth_lon            Float?
  base_lat             Float?
  base_lon             Float?
  base_sync_timestamp  DateTime? @db.Timestamptz(6)
  baseline_hrv_mean    Float?
  baseline_hrv_std     Float?
  baseline_gsr_mean    Float?
  baseline_gsr_std     Float?
  encrypted_gemini_key String?
  updated_at           DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model StockTarget {
  id             String   @id @default(cuid())
  code           String
  companyName    String
  market         String?
  price          Float?
  per            Float?
  pbr            Float?
  roe            Float?
  dividendYield  Float?
  analysisReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RealEstateTarget {
  id             String   @id @default(cuid())
  title          String
  url            String?
  price          Float?
  yield          Float?
  location       String?
  buildingAge    Int?
  propertyType   String?
  analysisReason String?
  source         String   @default("gas_rental_scraper")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimingAstrology {
  id               String   @id @default(cuid())
  date             DateTime
  kuseiType        String
  dailyDirection   String?
  monthlyDirection String?
  insight          String?
  source           String   @default("yakumoin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TelemetryLog {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  geomancyScore     Float?
  astrophysicsScore Float?
  magneticF         Float?
  hazardRisk        Float?
  kpIndex           Float?
  isPersonalVoid    Boolean  @default(false)
  metadata          String?
}

model MetaphysicalStateLog {
  id         String   @id @default(cuid())
  userId     String?
  targetDate DateTime

  environmentalBazi Json?
  personalBazi      Json?

  physicalLayers  Json?
  classicalLayers Json?

  ansLoad Float?
  kpIndex Float?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetDate])
  @@index([userId])
}

model MunicipalityWealth {
  id                       String   @id @default(cuid())
  areaCode                 String   @unique
  areaName                 String
  taxableIncomeThousandYen Float
  taxpayersCount           Float
  incomeYen                Float
  incomePerCapita          Float
  dataYear                 String?
  lat                      Float?
  lon                      Float?
  landPricePerSqm          Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model KnowledgeDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kb_id      Int      @unique @default(autoincrement()) // Base for generating tickets like KB000123
  status     String   @default("Draft")
  priority   String   @default("Medium")
  type       String   @default("Note")
  user_id    String?
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  content    String
  tags       String[]
  domain     String?
  category   String?
  embedding  Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

model XPost {
  id            String   @id
  url           String
  authorHandle  String
  authorDisplay String
  datetime      DateTime
  text          String
  quotedUrls    String[]
  externalLinks String[]
  savedMedia    String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorHandle])
  @@index([datetime])
}

model VisualizedComponent {
  id        String   @id @default(cuid())
  title     String
  style     String
  inputData Json
  cleanHtml String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================
// IR Analysis Models (Imported from ir_analyses)
// =====================================================

model Company {
  company_id    Int       @id @default(autoincrement())
  edinet_code   String    @unique @db.VarChar(6)
  security_code String?   @db.VarChar(5)
  company_name  String    @db.VarChar(200)
  industry_code String?   @db.VarChar(10)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  FinancialReports FinancialReport[]

  @@map("companies")
}

model FinancialItem {
  item_id    Int       @id @default(autoincrement())
  element_id String    @unique @db.VarChar(300)
  item_name  String    @db.VarChar(300)
  category   String?   @db.VarChar(50)
  unit_type  String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  FinancialData FinancialData[]

  @@map("financial_items")
}

model FinancialReport {
  report_id       Int       @id @default(autoincrement())
  company_id      Int
  document_type   String    @db.VarChar(50)
  fiscal_year     String    @db.VarChar(4)
  quarter_type    String?   @db.VarChar(10)
  fiscal_year_end DateTime  @db.Date
  filing_date     DateTime? @db.Date
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  Company       Company         @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  FinancialData FinancialData[]

  @@index([company_id, fiscal_year])
  @@map("financial_reports")
}

model FinancialData {
  data_id           BigInt    @id @default(autoincrement())
  report_id         Int
  item_id           Int
  context_id        String?   @db.VarChar(300)
  period_type       String    @db.VarChar(50)
  consolidated_type String    @db.VarChar(10)
  duration_type     String    @db.VarChar(10)
  value             Decimal?  @db.Decimal(20, 0)
  value_text        String?
  is_numeric        Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  FinancialReport FinancialReport @relation(fields: [report_id], references: [report_id], onDelete: Cascade)
  FinancialItem   FinancialItem   @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@index([period_type, consolidated_type])
  @@index([report_id, item_id])
  @@map("financial_data")
}

model RelocationHistory {
  id            String   @id @default(cuid())
  userId        String?
  departureDate DateTime
  datePrecision String   @default("DAY") // "YEAR" | "MONTH" | "DAY" | "HOUR"
  fromName      String
  fromLat       Float
  fromLon       Float
  toName        String
  toLat         Float
  toLon         Float
  purpose       String   @default("TRAVEL") // "MIGRATION" | "TRAVEL"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RelocationSimulation {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  steps     Json     // Array of step objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AgentTheme {
  id             String   @id @default(cuid())
  background     String
  foreground     String
  accent         String
  glowColor      String
  glowIntensity  Float
  animationSpeed String
  fontTheme      String
  noiseOpacity   Float
  borderRadius   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgentActivityLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  triggerType    String
  details        String
  thoughtProcess String
  actions        String
  textResponse   String?
  codeChange     Json?
  status         String
  errorMessage   String?
}


