# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
public/debug.txt

# env files (can opt-in for committing if needed)
.env*
# 雛形は秘密を含まないので追跡する（開発用 DB への向け先が書いてある）
!.env.local.example

# vercel
.vercel

# ... (rest of file)
# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local env files
.env
.env.local
.roo/
mcp.json
.env.development.local
.env.test.local
.env.production.local

# database
*.db
*.db-journal

# ... (rest)
# zip files
*.zip

# images
# public/images

*.log


# raw materials
/materials/

# Local backup of images (now in Supabase Storage)
/public/images/sanpeki/
/三碧木星/

# next-sitemap generated files
public/sitemap*.xml
public/robots.txt

/src/generated/prisma

# Text & Markdown Documents
*.txt
*.md
!README.md
!**/README.md
# QA 向けの画面仕様書は成果物としてリポジトリに残す。
# *.md を一括除外しているため、明示的に戻さないと追跡されない。
!docs/qa/*.md
# 移行・運用の手順書も同じ。README.md 以外が黙って無視されるため、
# 手順書を足したつもりが追跡されていない、という事故が起きる。
!docs/db-migration/*.md
!src/app/ads.txt/
!src/app/llms.txt/
!src/app/llms-full.txt/


# Data and Logs
data/
# ただし src/data はアプリのソースの一部。ビルド時に import しているので
# 除外すると CI のビルドだけが Module not found で落ちる（実際に起きた）。
!src/data/
!src/data/**
.gemini/
.npm-cache/

# Personal and Config Information
local_tactical_config.json
metaphysical_*.json
docs/metaphysical_*.json


# Ignore test and debug scripts
check_*.ts
test_*.ts
export_*.ts
scratch/

# Ignore generated CSVs
docs/*.csv

# Python / Scraper
__pycache__/
venv/
.venv/
scraper_state.json

# Playwright
playwright-report/
test-results/
blob-report/

# Generated reports and exports
docs/*.json
docs/*.html
*export*.json
nifty_*.html
*_properties.json
x_downloads/
download/
/tools/

# Environment configurations
env.json

# Katmer-Defuddle Data and Artifacts
katmer-defuddle/llm-wiki/raw/
katmer-defuddle/graphify-out/
katmer-defuddle/knowledge-base/public/analytics_data.json
eheya_state*.json
shamaison_state*.json
