# 開発用の上書き設定。これを .env.local としてコピーする。
#
# これが無いと npm run dev が本番 Supabase を直接向くため、
# ページを開いただけで本番の user_configs などに書き込みが飛ぶ。
# 実際に birth_date と base 座標を上書きする事故が起きている。
#
# Next.js は .env.local を .env より優先して読む。prisma.config.ts も
# 同じ順で読むようにしてあるので、prisma db push もこちらを見る。
#
#   cp .env.local.example .env.local
#   npm run dev:db:up
#   npm run dev:db:push
#   npm run dev
#
# 接続先は既存の docker-compose.yml が立てる Postgres（ポート 5433）の portfolio_dev。
# 同居している portfolio データベースには別プロジェクトのデータが入っているので触らない。
# portfolio_dev が無ければ:
#   docker exec my-portfolio-db-1 psql -U postgres -c "CREATE DATABASE portfolio_dev"
#
# 認証（Supabase Auth）は本番プロジェクトのまま使う。ログインしても
# 壊れるデータは無く、ローカルに Auth を立てる手間に見合わないため。
# 壊れるのは user_configs や rental_properties への書き込みで、
# それはこの DATABASE_URL の向き先で決まる。

DATABASE_URL="postgresql://postgres:password@localhost:5433/portfolio_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5433/portfolio_dev"
